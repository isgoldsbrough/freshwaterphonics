  "maths": {
    "topic": "The numbers 1, 2 and 3: find them, spot them without counting, show them",
    "vocab": [
      "one",
      "two",
      "three",
      "how many",
      "the same",
      "more",
      "fewer"
    ],
    "stems": [
      "\"How many? Don't count, just look.\"",
      "\"Show me three on your fingers.\"",
      "\"Find two of something.\""
    ],
    "source": "From the 16 October school update: finding, subitising and representing the numbers 1, 2 and 3.",
    "everyday": [
      "<b>Snacks:</b> put out one, two or three raisins and ask how many before they count.",
      "<b>Stairs and steps:</b> jump one, two, three.",
      "<b>Dice:</b> roll one dice with only 1 to 3 dots showing in play; say how many at a glance.",
      "<b>Fingers:</b> you show two, they show two."
    ],
