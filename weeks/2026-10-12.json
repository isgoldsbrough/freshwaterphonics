    "cues": {
      "s": "Hiss like a snake, sss. No voice.",
      "a": "Open wide, short a, as in apple.",
      "t": "Tongue tip taps behind the top teeth, t. No voice.",
      "p": "Pop the lips open, p. No voice.",
      "i": "Short i, as in in.",
      "n": "Tongue up, hum through the nose, nnn.",
      "m": "Lips together, hum, mmm.",
      "d": "Tongue tip taps behind the teeth, d, with voice.",
      "g": "Back of the tongue, short g, with voice.",
      "o": "Round mouth, short o, as in on.",
      "c": "Back of the tongue, short c. No voice.",
      "k": "Same sound as c, written k.",
      "ck": "Same sound as k. Two letters, one sound, at the end of short words.",
      "e": "Short e, as in egg.",
      "u": "Short u, as in up.",
      "r": "A soft growl, rrr. Keep it one sound, no uh on the end.",
      "h": "A small puff of air, like fogging a window, h. No voice.",
      "b": "Lips together, then open, b. Keep it short, no buh.",
      "f": "Top teeth on the bottom lip and blow, fff. No voice.",
      "l": "Tongue tip behind the top teeth, lll."
    },
